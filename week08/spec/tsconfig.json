{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "../dist",
    "types": ["node", "jasmine"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": ["../src/**/*", "./**/*"],
  "exclude": ["../node_modules", "../dist"]
}
